<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Music Player | Blue Purple Theme</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            background: linear-gradient(135deg, #0a0f2a 0%, #0f0c2c 50%, #1a1a3e 100%);
            font-family: 'Segoe UI', 'Inter', 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 1.5rem;
        }

        /* main player card - glassmorphism with purple/blue tones */
        .player-container {
            max-width: 520px;
            width: 100%;
            background: rgba(18, 16, 40, 0.75);
            backdrop-filter: blur(16px);
            border-radius: 2.8rem;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(120, 100, 255, 0.25);
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.3s;
            border: 1px solid rgba(100, 80, 255, 0.3);
        }

        .player-container:hover {
            transform: scale(1.01);
            box-shadow: 0 35px 55px rgba(80, 60, 200, 0.3);
        }

        /* header & now playing */
        .now-playing-bar {
            padding: 1.8rem 2rem 1rem 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(120, 100, 255, 0.2);
        }

        .badge {
            display: inline-block;
            background: linear-gradient(95deg, #7c4dff, #536dfe);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 0.25rem 1rem;
            border-radius: 100px;
            color: #ffffff;
            margin-bottom: 0.8rem;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(98, 0, 234, 0.4);
        }

        .song-title {
            font-size: 1.9rem;
            font-weight: 800;
            background: linear-gradient(135deg, #d9e2ff, #c084fc);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
            margin: 0.25rem 0 0.3rem;
            white-space: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: thin;
        }

        .song-artist {
            font-size: 1rem;
            font-weight: 500;
            color: #b9b3ff;
            margin-bottom: 0.75rem;
            opacity: 0.9;
        }

        /* cover art - purple/blue abstract */
        .cover-art {
            width: 140px;
            height: 140px;
            background: linear-gradient(145deg, #5e3bff, #2b3bff, #8a2be2);
            border-radius: 32px;
            margin: 1rem auto 0.8rem;
            box-shadow: 0 20px 32px -10px rgba(50, 20, 200, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            transition: all 0.2s;
            animation: subtleGlow 3s infinite alternate;
        }

        @keyframes subtleGlow {
            0% { box-shadow: 0 20px 32px -10px rgba(90, 50, 255, 0.4); }
            100% { box-shadow: 0 20px 38px -5px rgba(140, 80, 255, 0.8); }
        }

        /* progress area */
        .progress-section {
            padding: 0.5rem 1.8rem 0.8rem;
        }

        .time-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            font-weight: 600;
            color: #bfb9ff;
            margin-bottom: 0.5rem;
        }

        .progress-track {
            background: rgba(50, 40, 100, 0.6);
            border-radius: 40px;
            height: 6px;
            width: 100%;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .progress-fill {
            background: linear-gradient(90deg, #a855f7, #3b82f6);
            width: 0%;
            height: 6px;
            border-radius: 40px;
            position: relative;
            transition: width 0.05s linear;
            box-shadow: 0 0 6px #a78bfa;
        }

        /* controls */
        .controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            padding: 1rem 1.8rem 1.2rem;
        }

        .ctrl-btn {
            background: rgba(30, 25, 70, 0.85);
            border: 1px solid rgba(139, 92, 246, 0.5);
            width: 52px;
            height: 52px;
            border-radius: 60px;
            font-size: 1.6rem;
            color: #e0d9ff;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(4px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .ctrl-btn:active {
            transform: scale(0.94);
        }

        .ctrl-btn.play-pause {
            background: linear-gradient(145deg, #7c3aed, #4f46e5);
            color: white;
            width: 64px;
            height: 64px;
            font-size: 2rem;
            box-shadow: 0 8px 22px rgba(79, 70, 229, 0.5);
            border: none;
        }

        .ctrl-btn:hover {
            background: #6d28d9;
            color: white;
            border-color: #a78bfa;
        }

        /* volume row */
        .volume-control {
            padding: 0rem 1.8rem 1rem 1.8rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .volume-icon {
            color: #b9aeff;
            font-size: 1.2rem;
        }

        .volume-slider {
            flex: 1;
            height: 4px;
            -webkit-appearance: none;
            background: rgba(100, 80, 200, 0.4);
            border-radius: 10px;
            outline: none;
        }

        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            background: #c084fc;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 5px #b77cff;
            border: none;
        }

        /* playlist section - blue/purple deep */
        .playlist-section {
            background: rgba(12, 10, 30, 0.75);
            border-top: 1px solid rgba(100, 70, 220, 0.4);
            padding: 1rem 1.5rem 1.5rem;
            margin-top: 0.5rem;
        }

        .playlist-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1rem;
        }

        .playlist-header h4 {
            color: #c7bbff;
            font-weight: 600;
            letter-spacing: 0.5px;
            font-size: 0.9rem;
        }

        .autoplay-toggle {
            background: #2a234a;
            border: none;
            border-radius: 40px;
            padding: 0.3rem 0.9rem;
            font-size: 0.7rem;
            font-weight: bold;
            color: #cdc4ff;
            cursor: pointer;
            transition: 0.2s;
        }

        .autoplay-active {
            background: linear-gradient(95deg, #7c4dff, #4f46e5);
            color: white;
            box-shadow: 0 0 8px #a855f7;
        }

        .playlist-items {
            list-style: none;
            max-height: 210px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .playlist-items li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(40, 35, 85, 0.6);
            margin-bottom: 0.6rem;
            padding: 0.6rem 1rem;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.2s;
            color: #e9e2ff;
            border: 1px solid transparent;
        }

        .playlist-items li.active-song {
            background: linear-gradient(115deg, #5b3fcc, #3b36c7);
            color: white;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(108, 70, 255, 0.5);
            border-color: #a78bfa;
        }

        .playlist-items li .track-meta {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .playlist-items li .track-name {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .playlist-items li .track-artist {
            font-size: 0.7rem;
            opacity: 0.8;
        }

        .playlist-items li .track-duration {
            font-size: 0.7rem;
            font-family: monospace;
            background: rgba(0, 0, 0, 0.4);
            padding: 0.2rem 0.6rem;
            border-radius: 30px;
        }

        .playlist-items::-webkit-scrollbar {
            width: 3px;
        }
        .playlist-items::-webkit-scrollbar-track {
            background: #1e1a3a;
        }
        .playlist-items::-webkit-scrollbar-thumb {
            background: #a78bfa;
            border-radius: 6px;
        }

        /* loading indicator */
        .loading-toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #2d2a55;
            color: #e0d6ff;
            padding: 6px 16px;
            border-radius: 40px;
            font-size: 0.75rem;
            font-weight: 500;
            z-index: 200;
            backdrop-filter: blur(12px);
            transition: opacity 0.2s;
            pointer-events: none;
            opacity: 0;
            font-family: monospace;
        }
        @media (max-width: 480px) {
            .controls { gap: 1rem; }
            .ctrl-btn { width: 46px; height: 46px; font-size: 1.3rem; }
            .ctrl-btn.play-pause { width: 56px; height: 56px; }
            .song-title { font-size: 1.4rem; white-space: normal; word-break: break-word; }
            .playlist-items li { padding: 0.5rem 0.8rem; }
        }
    </style>
</head>
<body>

<div class="player-container" id="musicPlayerApp">
    <div class="now-playing-bar">
        <span class="badge">🎧 MUSIC PLAYER</span>
        <div class="cover-art" id="dynamicCover">🎵</div>
        <div class="song-title" id="songTitle">Midnight Violet</div>
        <div class="song-artist" id="songArtist">Purple Haze</div>
    </div>

    <div class="progress-section">
        <div class="time-info">
            <span id="currentTime">0:00</span>
            <span id="totalDuration">0:00</span>
        </div>
        <div class="progress-track" id="progressTrack">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>

    <div class="controls">
        <button class="ctrl-btn" id="prevBtn" aria-label="Previous">⏮</button>
        <button class="ctrl-btn play-pause" id="playPauseBtn" aria-label="Play/Pause">▶</button>
        <button class="ctrl-btn" id="nextBtn" aria-label="Next">⏭</button>
    </div>

    <div class="volume-control">
        <span class="volume-icon">🔊</span>
        <input type="range" id="volumeSlider" class="volume-slider" min="0" max="1" step="0.01" value="0.7">
    </div>

    <div class="playlist-section">
        <div class="playlist-header">
            <h4>📀 PLAYLIST · 6 TRACKS</h4>
            <button id="autoplayToggleBtn" class="autoplay-toggle">🔁 AUTO OFF</button>
        </div>
        <ul class="playlist-items" id="playlistContainer"></ul>
    </div>
</div>
<div id="loadingToast" class="loading-toast">🎵 Loading track...</div>

<script>
    // Music library with fast-loading audio tracks
    const songs = [
        { title: "Midnight Violet", artist: "Purple Haze", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3", duration: "3:42" },
        { title: "Neon Nebula", artist: "Blue Echo", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3", duration: "3:10" },
        { title: "Astral Drift", artist: "Lavender Sky", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3", duration: "4:01" },
        { title: "Deep Indigo", artist: "Chromatica", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3", duration: "3:28" },
        { title: "Phantom Dance", artist: "Velvet Code", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3", duration: "2:55" },
        { title: "Stellar Waves", artist: "Amethyst", src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3", duration: "3:49" }
    ];

    // DOM elements
    const audio = new Audio();
    const playPauseBtn = document.getElementById('playPauseBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const progressTrack = document.getElementById('progressTrack');
    const progressFill = document.getElementById('progressFill');
    const currentTimeSpan = document.getElementById('currentTime');
    const totalDurationSpan = document.getElementById('totalDuration');
    const volumeSlider = document.getElementById('volumeSlider');
    const songTitleSpan = document.getElementById('songTitle');
    const songArtistSpan = document.getElementById('songArtist');
    const playlistContainer = document.getElementById('playlistContainer');
    const autoplayToggleBtn = document.getElementById('autoplayToggleBtn');
    const loadingToast = document.getElementById('loadingToast');

    let currentSongIndex = 0;
    let isPlaying = false;
    let autoplayEnabled = false;
    let isDraggingProgress = false;
    let loadingTimeout = null;

    function showLoading(show) {
        if (show) {
            if (loadingTimeout) clearTimeout(loadingTimeout);
            loadingToast.style.opacity = '1';
            loadingToast.style.transition = 'opacity 0.15s';
            loadingTimeout = setTimeout(() => {
                if (loadingToast.style.opacity === '1') loadingToast.style.opacity = '0';
            }, 1800);
        } else {
            loadingToast.style.opacity = '0';
            if (loadingTimeout) clearTimeout(loadingTimeout);
        }
    }

    function formatTime(seconds) {
        if (isNaN(seconds) || seconds === Infinity) return "0:00";
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function loadSong(index, autoPlayAfterLoad = false) {
        if (index < 0) index = songs.length - 1;
        if (index >= songs.length) index = 0;
        currentSongIndex = index;
        const song = songs[currentSongIndex];
        
        showLoading(true);
        
        const needNewSrc = (audio.src !== song.src);
        if (needNewSrc) {
            audio.src = song.src;
            audio.load();
        }
        
        songTitleSpan.textContent = song.title;
        songArtistSpan.textContent = song.artist;
        const coverDiv = document.getElementById('dynamicCover');
        const emojis = ["🎵", "🎶", "🎧", "🌟", "🌙", "🔥"];
        coverDiv.textContent = emojis[currentSongIndex % emojis.length];
        
        progressFill.style.width = '0%';
        currentTimeSpan.textContent = '0:00';
        totalDurationSpan.textContent = song.duration;
        
        highlightActivePlaylist();
        
        const metadataHandler = () => {
            if (audio.duration && isFinite(audio.duration)) {
                totalDurationSpan.textContent = formatTime(audio.duration);
            } else {
                totalDurationSpan.textContent = song.duration;
            }
            audio.removeEventListener('loadedmetadata', metadataHandler);
        };
        audio.addEventListener('loadedmetadata', metadataHandler);
        
        if (autoPlayAfterLoad || isPlaying) {
            const playPromise = audio.play();
            if (playPromise !== undefined) {
                playPromise.then(() => {
                    isPlaying = true;
                    playPauseBtn.textContent = '⏸';
                    showLoading(false);
                }).catch(err => {
                    console.warn("Playback prevented:", err);
                    isPlaying = false;
                    playPauseBtn.textContent = '▶';
                    showLoading(false);
                });
            } else {
                audio.play();
                isPlaying = true;
                playPauseBtn.textContent = '⏸';
                showLoading(false);
            }
        } else {
            audio.pause();
            isPlaying = false;
            playPauseBtn.textContent = '▶';
            showLoading(false);
        }
    }

    function togglePlayPause() {
        if (audio.paused) {
            if (audio.readyState < 2) showLoading(true);
            audio.play().then(() => {
                isPlaying = true;
                playPauseBtn.textContent = '⏸';
                showLoading(false);
            }).catch(err => {
                console.error("Play error:", err);
                showLoading(false);
                isPlaying = false;
                playPauseBtn.textContent = '▶';
            });
        } else {
            audio.pause();
            isPlaying = false;
            playPauseBtn.textContent = '▶';
            showLoading(false);
        }
    }

    function nextSong() {
        const newIndex = (currentSongIndex + 1) % songs.length;
        const wasPlaying = isPlaying;
        loadSong(newIndex, wasPlaying);
    }

    function prevSong() {
        const newIndex = (currentSongIndex - 1 + songs.length) % songs.length;
        const wasPlaying = isPlaying;
        loadSong(newIndex, wasPlaying);
    }

    function updateProgress() {
        if (!isDraggingProgress && audio.duration && isFinite(audio.duration)) {
            const percent = (audio.currentTime / audio.duration) * 100;
            progressFill.style.width = `${percent}%`;
            currentTimeSpan.textContent = formatTime(audio.currentTime);
        }
    }

    function handleProgressSeek(e) {
        const rect = progressTrack.getBoundingClientRect();
        let clickX = e.clientX - rect.left;
        let widthRatio = Math.min(1, Math.max(0, clickX / rect.width));
        if (audio.duration && isFinite(audio.duration)) {
            const seekTime = widthRatio * audio.duration;
            audio.currentTime = seekTime;
            progressFill.style.width = `${widthRatio * 100}%`;
            currentTimeSpan.textContent = formatTime(seekTime);
        }
    }

    function setVolume(value) {
        audio.volume = parseFloat(value);
        volumeSlider.value = value;
    }

    function onSongEnd() {
        if (autoplayEnabled) {
            nextSong();
        } else {
            isPlaying = false;
            playPauseBtn.textContent = '▶';
            progressFill.style.width = '0%';
            currentTimeSpan.textContent = '0:00';
        }
    }
    
    function renderPlaylist() {
        playlistContainer.innerHTML = '';
        songs.forEach((song, idx) => {
            const li = document.createElement('li');
            li.setAttribute('data-index', idx);
            li.innerHTML = `
                <div class="track-meta">
                    <span class="track-name">${escapeHtml(song.title)}</span>
                    <span class="track-artist">${escapeHtml(song.artist)}</span>
                </div>
                <span class="track-duration">${song.duration}</span>
            `;
            li.addEventListener('click', (e) => {
                e.stopPropagation();
                loadSong(idx, true);
            });
            playlistContainer.appendChild(li);
        });
        highlightActivePlaylist();
    }
    
    function highlightActivePlaylist() {
        const items = document.querySelectorAll('#playlistContainer li');
        items.forEach((item, idx) => {
            if (idx === currentSongIndex) {
                item.classList.add('active-song');
            } else {
                item.classList.remove('active-song');
            }
        });
    }
    
    function toggleAutoplay() {
        autoplayEnabled = !autoplayEnabled;
        if (autoplayEnabled) {
            autoplayToggleBtn.textContent = '♾️ AUTO ON';
            autoplayToggleBtn.classList.add('autoplay-active');
        } else {
            autoplayToggleBtn.textContent = '🔁 AUTO OFF';
            autoplayToggleBtn.classList.remove('autoplay-active');
        }
    }
    
    function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }
    
    function initEventListeners() {
        playPauseBtn.addEventListener('click', togglePlayPause);
        prevBtn.addEventListener('click', prevSong);
        nextBtn.addEventListener('click', nextSong);
        audio.addEventListener('timeupdate', updateProgress);
        audio.addEventListener('ended', onSongEnd);
        volumeSlider.addEventListener('input', (e) => setVolume(e.target.value));
        
        progressTrack.addEventListener('mousedown', (e) => {
            isDraggingProgress = true;
            handleProgressSeek(e);
            document.addEventListener('mousemove', onMouseMoveSeek);
            document.addEventListener('mouseup', onMouseUpSeek);
        });
        function onMouseMoveSeek(e) {
            if (isDraggingProgress) handleProgressSeek(e);
        }
        function onMouseUpSeek() {
            isDraggingProgress = false;
            document.removeEventListener('mousemove', onMouseMoveSeek);
            document.removeEventListener('mouseup', onMouseUpSeek);
        }
        
        autoplayToggleBtn.addEventListener('click', toggleAutoplay);
        
        audio.addEventListener('error', () => {
            console.warn("Audio error occurred");
            if (autoplayEnabled) {
                nextSong();
            } else {
                audio.pause();
                isPlaying = false;
                playPauseBtn.textContent = '▶';
            }
        });
    }
    
    function initPlayer() {
        renderPlaylist();
        audio.volume = 0.7;
        volumeSlider.value = '0.7';
        audio.preload = 'auto';
        currentSongIndex = 0;
        const firstSong = songs[0];
        audio.src = firstSong.src;
        audio.load();
        songTitleSpan.textContent = firstSong.title;
        songArtistSpan.textContent = firstSong.artist;
        totalDurationSpan.textContent = firstSong.duration;
        progressFill.style.width = '0%';
        currentTimeSpan.textContent = '0:00';
        highlightActivePlaylist();
        isPlaying = false;
        playPauseBtn.textContent = '▶';
        
        audio.addEventListener('loadedmetadata', () => {
            if (audio.duration) totalDurationSpan.textContent = formatTime(audio.duration);
        }, { once: true });
        
        initEventListeners();
        autoplayToggleBtn.textContent = '🔁 AUTO OFF';
        autoplayEnabled = false;
    }
    
    initPlayer();
</script>
</body>
</html>
